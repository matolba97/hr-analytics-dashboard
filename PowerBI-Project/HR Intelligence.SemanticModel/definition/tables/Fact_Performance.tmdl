		isHidden
		isAvailableInMdx: false
		lineageTag: af13138a-e2b7-4230-ab7d-130973cfbf4a
		summarizeBy: none
		sourceColumn: Teamwork Score

	/// Overall Rating, sourced or reproducibly derived from the HR extract.
	column 'Overall Rating'
		dataType: string
		lineageTag: bf068d72-d2e8-4dad-b1a1-120c3e051d3a
		summarizeBy: none
		sourceColumn: Overall Rating

	/// Promotion Recommendation, sourced or reproducibly derived from the HR extract.
	column 'Promotion Recommendation'
		dataType: string
		lineageTag: fe530e3e-3746-482f-ab81-270611e3d7f7
