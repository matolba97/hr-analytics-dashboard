/// Fact: one employee review event, identified by Performance ID. Employee Key relates to Dim_Employee and Review Date actively relates to Dim_Date. Reviewer ID is descriptive without a second active employee relationship; self reviews are flagged. Composite score is an analyst-defined equal-weight mean of four source components.
table Fact_Performance
	lineageTag: 03ed0bfd-f2d4-4208-a534-cecb727c0edf

	/// Performance ID, sourced or reproducibly derived from the HR extract.
	column 'Performance ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: cea7c5f7-d439-41a9-ae42-a1cd280c55ff
		summarizeBy: none
		sourceColumn: Performance ID

	/// Employee ID, sourced or reproducibly derived from the HR extract.
	column 'Employee ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 3b885012-293c-483d-b1ea-3655d763d05a
		summarizeBy: none
		sourceColumn: Employee ID

	/// Review Date, sourced or reproducibly derived from the HR extract.
	column 'Review Date'
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: 7fd60757-a203-4789-9d4f-649e1b477de5
		summarizeBy: none
		sourceColumn: Review Date

	/// Reviewer ID, sourced or reproducibly derived from the HR extract.
	column 'Reviewer ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: b50f7362-0248-4e9e-8797-a56589403b55
		summarizeBy: none
		sourceColumn: Reviewer ID

	/// KPI Score, sourced or reproducibly derived from the HR extract.
	column 'KPI Score'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: caf1f0c6-71dc-4987-b55a-c058b98f4710
		summarizeBy: none
		sourceColumn: KPI Score

	/// Productivity Score, sourced or reproducibly derived from the HR extract.
	column 'Productivity Score'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: d64a9efe-8992-4ab2-8e00-2e87e45e4b75
		summarizeBy: none
		sourceColumn: Productivity Score

	/// Attendance Score, sourced or reproducibly derived from the HR extract.
	column 'Attendance Score'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		lineageTag: 2b68a191-a502-46a8-965a-9ef26ebcbf99
		summarizeBy: none
		sourceColumn: Attendance Score

	/// Teamwork Score, sourced or reproducibly derived from the HR extract.
	column 'Teamwork Score'
