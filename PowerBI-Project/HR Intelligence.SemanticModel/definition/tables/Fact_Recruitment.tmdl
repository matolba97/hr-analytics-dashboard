		lineageTag: ba014bb2-6807-40b7-b8a9-85f6443525cc
		summarizeBy: none
		sourceColumn: Hiring Status

	/// Joining Date, sourced or reproducibly derived from the HR extract.
	column 'Joining Date'
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: 13080fe2-0fe7-454c-939e-207bd2c2778c
		summarizeBy: none
		sourceColumn: Joining Date

	/// Department Key, sourced or reproducibly derived from the HR extract.
	column 'Department Key'
		dataType: int64
