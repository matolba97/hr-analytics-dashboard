		sourceColumn: Interview Date

	/// Recruiter ID, sourced or reproducibly derived from the HR extract.
	column 'Recruiter ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: fd53b379-465c-49e7-b840-b4059f2675c8
		summarizeBy: none
		sourceColumn: Recruiter ID

	/// Interview Score, sourced or reproducibly derived from the HR extract.
	column 'Interview Score'
