/// Fact: one candidate application, identified by Recruitment ID. Department Key relates to Dim_Department; Application Date actively and Interview/Joining Dates inactively relate to Dim_Date. Hiring Status is a current outcome snapshot. No candidate-to-employee linkage or recruitment stage history exists; employee job/grade filters do not propagate here.
table Fact_Recruitment
	lineageTag: 29d4fe5a-61b4-4f58-b42f-421d25ddd775

	/// Recruitment ID, sourced or reproducibly derived from the HR extract.
	column 'Recruitment ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: ee94ff0c-e38d-4fc2-8f3a-605f30d45141
		summarizeBy: none
		sourceColumn: Recruitment ID

	/// Candidate ID, sourced or reproducibly derived from the HR extract.
	column 'Candidate ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 79bcdad8-f32b-426c-a91b-721e37b75235
		summarizeBy: none
		sourceColumn: Candidate ID

	/// Position, sourced or reproducibly derived from the HR extract.
	column Position
		dataType: string
		lineageTag: ea512749-4178-4f3d-bdd7-60ccf1395df8
		summarizeBy: none
		sourceColumn: Position

	/// Department ID, sourced or reproducibly derived from the HR extract.
	column 'Department ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: ab19015e-9d1e-4933-b743-6522801d1824
		summarizeBy: none
		sourceColumn: Department ID

	/// Application Date, sourced or reproducibly derived from the HR extract.
	column 'Application Date'
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: f2f691e2-970c-427e-84f6-8ae42d49650e
		summarizeBy: none
