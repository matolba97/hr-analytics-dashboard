	/// Recorded labor time including regular and overtime hours. Calculation: Working Hours + Overtime Hours. Purpose: Adds the separate source components once; check-in/out reconciliation included overnight shifts. Unit: Hours. Date/filter context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent. Empty/zero behavior: Existing DAX scalar and arithmetic BLANK behavior is preserved; no new empty-result substitution is added. Limitations: No double-counting of elapsed clock time; DAX arithmetic retains its existing blank-to-number coercion. Interpretation: Total recorded labor input, not scheduled capacity.
	measure 'Total Hours Worked' =
			// Recorded labor time including regular and overtime hours.
			// Why: Adds the separate source components once; check-in/out reconciliation included overnight shifts.
			// Logic: Working Hours + Overtime Hours.
			// Context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent.
			// Empty/zero: Existing DAX scalar and arithmetic BLANK behavior is preserved; no new empty-result substitution is added.
			// Unit: Hours.
			// Caveat: No double-counting of elapsed clock time; DAX arithmetic retains its existing blank-to-number coercion.
			[Working Hours]+[Overtime Hours]
		formatString: #,##0.0
		displayFolder: 03 Attendance
		lineageTag: 3fb06f62-bf8f-4ed9-9dbd-6aeac4fb488c

	/// Total regular-plus-overtime hours per recorded employee-day. Calculation: Total Hours Worked / Attendance Records. Purpose: Normalizes all recorded labor time using the compatible observation count. Unit: Hours per recorded employee-day. Date/filter context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent. Empty/zero behavior: DIVIDE returns BLANK for a zero or BLANK denominator; a BLANK numerator also stays BLANK even with a positive denominator. No alternate result is supplied. Limitations: Zero or BLANK record count returns BLANK; unrecorded days remain outside the denominator. Interpretation: Includes zero-hour statuses; not the mean among attended shifts only.
	measure 'Average Total Hours Worked' =
			// Total regular-plus-overtime hours per recorded employee-day.
			// Why: Normalizes all recorded labor time using the compatible observation count.
			// Logic: Total Hours Worked / Attendance Records.
			// Context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent.
			// Empty/zero: DIVIDE returns BLANK for a zero or BLANK denominator; a BLANK numerator also stays BLANK even with a positive denominator. No alternate result is supplied.
			// Unit: Hours per recorded employee-day.
			// Caveat: Zero or BLANK record count returns BLANK; unrecorded days remain outside the denominator.
			DIVIDE([Total Hours Worked],[Attendance Records])
		formatString: 0.0
		displayFolder: 03 Attendance
		lineageTag: ebf163a6-a281-4264-a55e-f7c5ac60f5e8

	/// Fraction of total recorded labor time attributable to overtime. Calculation: Overtime Hours / Total Hours Worked. Purpose: Uses regular plus overtime as a common denominator for a true total-hours share. Unit: Ratio stored as a fraction; displayed as a percentage with one decimal place. Date/filter context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent. Empty/zero behavior: DIVIDE returns BLANK for a zero or BLANK denominator; a BLANK numerator also stays BLANK even with a positive denominator. No alternate result is supplied. Limitations: Zero or BLANK total hours returns BLANK; this is not overtime cost share. Interpretation: Higher indicates a larger overtime mix of observed labor time.
	measure 'Overtime Share of Total Hours' =
			// Fraction of total recorded labor time attributable to overtime.
			// Why: Uses regular plus overtime as a common denominator for a true total-hours share.
			// Logic: Overtime Hours / Total Hours Worked.
			// Context: Active Attendance Date and Department/Employee filters select recorded employee-days. Latest source observation is 27 June 2025; unrecorded dates are not inferred absent.
			// Empty/zero: DIVIDE returns BLANK for a zero or BLANK denominator; a BLANK numerator also stays BLANK even with a positive denominator. No alternate result is supplied.
			// Unit: Ratio stored as a fraction; displayed as a percentage with one decimal place.
			// Caveat: Zero or BLANK total hours returns BLANK; this is not overtime cost share.
			DIVIDE([Overtime Hours],[Total Hours Worked])
		formatString: 0.0%
		displayFolder: 03 Attendance
		lineageTag: d44e7d39-9e41-4345-a33b-79f6f926bce2

